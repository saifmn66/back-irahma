{
  "info": {
    "_postman_id": "irahma-school-api-v1",
    "name": "Irahma School API",
    "description": "Complete API test collection for Irahma School backend.\n\n**Folder order:** Auth → Teachers → Students → Classes → Subjects → ClassSubjects → Timetable → Attendance\n\n**Setup:** Run the Auth login first to capture the token, then seed IDs into the environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "authToken", "value": "" },
    { "key": "newTeacherId", "value": "" },
    { "key": "newStudentId", "value": "" },
    { "key": "newClassId", "value": "" },
    { "key": "newSubjectId", "value": "" },
    { "key": "newCsId", "value": "" },
    { "key": "newTimetableId", "value": "" },
    { "key": "newAttendanceId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST login (teacher by teacherNumber)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('token returned', () => pm.expect(j.data.token).to.be.a('string'));",
            "pm.collectionVariables.set('authToken', j.data.token);"
          ]}}],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"teacherNumber\": \"SEED-T001\",\n  \"password\": \"SEED-T001\",\n  \"role\": \"teacher\"\n}" }
          }
        },
        {
          "name": "POST login (student by studentNumber)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('role is student', () => pm.expect(pm.response.json().data.role).to.eql('student'));"
          ]}}],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"studentNumber\": \"SEED-S001\",\n  \"password\": \"SEED-S001\",\n  \"role\": \"student\"\n}" }
          }
        },
        {
          "name": "POST login — wrong password → 401",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] }}],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"teacherNumber\": \"SEED-T001\",\n  \"password\": \"wrong\"\n}" }
          }
        },
        {
          "name": "POST login — missing identifier → 400",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] }}],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"test\"\n}" }
          }
        },
        {
          "name": "GET /api/auth/me (with token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('profile present', () => pm.expect(pm.response.json().data.profile).to.exist);"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me",
            "header": [{"key":"Authorization","value":"Bearer {{authToken}}"}]
          }
        },
        {
          "name": "GET /api/auth/me — no token → 401",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] }}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "POST /api/auth/change-password",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }}],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/change-password",
            "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"SEED-T001\",\n  \"newPassword\": \"SEED-T001\"\n}" }
          }
        },
        {
          "name": "POST /api/auth/logout",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }}],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
